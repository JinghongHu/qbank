 "circuit_qasm3": "OPENQASM 3.0;\ninclude \"stdgates.inc\";\ninput float[64] beta_0;\ninput float[64] beta_1;\ninput float[64] gamma_0;\ninput float[64] gamma_1;\ngate rzz(p0) _gate_q_0, _gate_q_1 {\n  cx _gate_q_0, _gate_q_1;\n  rz(p0) _gate_q_1;\n  cx _gate_q_0, _gate_q_1;\n}\nqubit[9] q;\nh q[0];\nh q[1];\nh q[2];\nh q[3];\nh q[4];\nh q[5];\nh q[6];\nh q[7];\nh q[8];\nrzz(gamma_0) q[0], q[1];\nrzz(gamma_0) q[0], q[4];\nrzz(gamma_0) q[0], q[5];\nrzz(gamma_0) q[0], q[6];\nrzz(gamma_0) q[0], q[7];\nrzz(gamma_0) q[0], q[8];\nrzz(gamma_0) q[1], q[3];\nrzz(gamma_0) q[1], q[5];\nrzz(gamma_0) q[1], q[7];\nrzz(gamma_0) q[2], q[3];\nrzz(gamma_0) q[2], q[8];\nrzz(gamma_0) q[3], q[4];\nrzz(gamma_0) q[3], q[6];\nrzz(gamma_0) q[3], q[7];\nrzz(gamma_0) q[4], q[5];\nrzz(gamma_0) q[4], q[6];\nrzz(gamma_0) q[4], q[7];\nrzz(gamma_0) q[4], q[8];\nrzz(gamma_0) q[5], q[6];\nrzz(gamma_0) q[6], q[7];\nrx(beta_0) q[0];\nrx(beta_0) q[1];\nrx(beta_0) q[2];\nrx(beta_0) q[3];\nrx(beta_0) q[4];\nrx(beta_0) q[5];\nrx(beta_0) q[6];\nrx(beta_0) q[7];\nrx(beta_0) q[8];\nrzz(gamma_1) q[0], q[1];\nrzz(gamma_1) q[0], q[4];\nrzz(gamma_1) q[0], q[5];\nrzz(gamma_1) q[0], q[6];\nrzz(gamma_1) q[0], q[7];\nrzz(gamma_1) q[0], q[8];\nrzz(gamma_1) q[1], q[3];\nrzz(gamma_1) q[1], q[5];\nrzz(gamma_1) q[1], q[7];\nrzz(gamma_1) q[2], q[3];\nrzz(gamma_1) q[2], q[8];\nrzz(gamma_1) q[3], q[4];\nrzz(gamma_1) q[3], q[6];\nrzz(gamma_1) q[3], q[7];\nrzz(gamma_1) q[4], q[5];\nrzz(gamma_1) q[4], q[6];\nrzz(gamma_1) q[4], q[7];\nrzz(gamma_1) q[4], q[8];\nrzz(gamma_1) q[5], q[6];\nrzz(gamma_1) q[6], q[7];\nrx(beta_1) q[0];\nrx(beta_1) q[1];\nrx(beta_1) q[2];\nrx(beta_1) q[3];\nrx(beta_1) q[4];\nrx(beta_1) q[5];\nrx(beta_1) q[6];\nrx(beta_1) q[7];\nrx(beta_1) q[8];\n",

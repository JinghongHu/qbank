 "circuit_qasm3": "OPENQASM 3.0;\ninclude \"stdgates.inc\";\ninput float[64] J_xx;\ninput float[64] J_yy;\ninput float[64] J_zz;\ninput float[64] h_0;\ngate rxx(p0) _gate_q_0, _gate_q_1 {\n  h _gate_q_0;\n  h _gate_q_1;\n  cx _gate_q_0, _gate_q_1;\n  rz(p0) _gate_q_1;\n  cx _gate_q_0, _gate_q_1;\n  h _gate_q_1;\n  h _gate_q_0;\n}\ngate sxdg _gate_q_0 {\n  s _gate_q_0;\n  h _gate_q_0;\n  s _gate_q_0;\n}\ngate ryy(p0) _gate_q_0, _gate_q_1 {\n  sxdg _gate_q_0;\n  sxdg _gate_q_1;\n  cx _gate_q_0, _gate_q_1;\n  rz(p0) _gate_q_1;\n  cx _gate_q_0, _gate_q_1;\n  sx _gate_q_0;\n  sx _gate_q_1;\n}\ngate rzz(p0) _gate_q_0, _gate_q_1 {\n  cx _gate_q_0, _gate_q_1;\n  rz(p0) _gate_q_1;\n  cx _gate_q_0, _gate_q_1;\n}\nqubit[11] q;\nrxx(J_xx) q[1], q[2];\nrxx(J_xx) q[1], q[4];\nrxx(J_xx) q[1], q[7];\nrxx(J_xx) q[2], q[3];\nrxx(J_xx) q[3], q[8];\nrxx(J_xx) q[3], q[9];\nrxx(J_xx) q[4], q[7];\nrxx(J_xx) q[5], q[6];\nrxx(J_xx) q[5], q[8];\nrxx(J_xx) q[5], q[10];\nrxx(J_xx) q[8], q[9];\nrxx(J_xx) q[9], q[10];\nryy(J_yy) q[1], q[2];\nryy(J_yy) q[1], q[4];\nryy(J_yy) q[1], q[7];\nryy(J_yy) q[2], q[3];\nryy(J_yy) q[3], q[8];\nryy(J_yy) q[3], q[9];\nryy(J_yy) q[4], q[7];\nryy(J_yy) q[5], q[6];\nryy(J_yy) q[5], q[8];\nryy(J_yy) q[5], q[10];\nryy(J_yy) q[8], q[9];\nryy(J_yy) q[9], q[10];\nrzz(J_zz) q[1], q[2];\nrzz(J_zz) q[1], q[4];\nrzz(J_zz) q[1], q[7];\nrzz(J_zz) q[2], q[3];\nrzz(J_zz) q[3], q[8];\nrzz(J_zz) q[3], q[9];\nrzz(J_zz) q[4], q[7];\nrzz(J_zz) q[5], q[6];\nrzz(J_zz) q[5], q[8];\nrzz(J_zz) q[5], q[10];\nrzz(J_zz) q[8], q[9];\nrzz(J_zz) q[9], q[10];\nrz(h_0) q[0];\nrz(h_0) q[1];\nrz(h_0) q[2];\nrz(h_0) q[3];\nrz(h_0) q[4];\nrz(h_0) q[5];\nrz(h_0) q[6];\nrz(h_0) q[7];\nrz(h_0) q[8];\nrz(h_0) q[9];\nrz(h_0) q[10];\n",

 "circuit_qasm3": "OPENQASM 3.0;\ninclude \"stdgates.inc\";\ninput float[64] J_xx;\ninput float[64] J_yy;\ninput float[64] J_zz;\ninput float[64] h_0;\ngate rxx(p0) _gate_q_0, _gate_q_1 {\n  h _gate_q_0;\n  h _gate_q_1;\n  cx _gate_q_0, _gate_q_1;\n  rz(p0) _gate_q_1;\n  cx _gate_q_0, _gate_q_1;\n  h _gate_q_1;\n  h _gate_q_0;\n}\ngate sxdg _gate_q_0 {\n  s _gate_q_0;\n  h _gate_q_0;\n  s _gate_q_0;\n}\ngate ryy(p0) _gate_q_0, _gate_q_1 {\n  sxdg _gate_q_0;\n  sxdg _gate_q_1;\n  cx _gate_q_0, _gate_q_1;\n  rz(p0) _gate_q_1;\n  cx _gate_q_0, _gate_q_1;\n  sx _gate_q_0;\n  sx _gate_q_1;\n}\ngate rzz(p0) _gate_q_0, _gate_q_1 {\n  cx _gate_q_0, _gate_q_1;\n  rz(p0) _gate_q_1;\n  cx _gate_q_0, _gate_q_1;\n}\nqubit[16] q;\nrxx(J_xx) q[0], q[6];\nrxx(J_xx) q[1], q[4];\nrxx(J_xx) q[4], q[8];\nrxx(J_xx) q[4], q[12];\nrxx(J_xx) q[4], q[14];\nrxx(J_xx) q[4], q[15];\nrxx(J_xx) q[5], q[6];\nrxx(J_xx) q[5], q[13];\nrxx(J_xx) q[6], q[13];\nrxx(J_xx) q[7], q[9];\nrxx(J_xx) q[8], q[11];\nrxx(J_xx) q[8], q[12];\nrxx(J_xx) q[9], q[15];\nrxx(J_xx) q[10], q[11];\nrxx(J_xx) q[10], q[12];\nrxx(J_xx) q[10], q[14];\nrxx(J_xx) q[11], q[12];\nrxx(J_xx) q[12], q[14];\nryy(J_yy) q[0], q[6];\nryy(J_yy) q[1], q[4];\nryy(J_yy) q[4], q[8];\nryy(J_yy) q[4], q[12];\nryy(J_yy) q[4], q[14];\nryy(J_yy) q[4], q[15];\nryy(J_yy) q[5], q[6];\nryy(J_yy) q[5], q[13];\nryy(J_yy) q[6], q[13];\nryy(J_yy) q[7], q[9];\nryy(J_yy) q[8], q[11];\nryy(J_yy) q[8], q[12];\nryy(J_yy) q[9], q[15];\nryy(J_yy) q[10], q[11];\nryy(J_yy) q[10], q[12];\nryy(J_yy) q[10], q[14];\nryy(J_yy) q[11], q[12];\nryy(J_yy) q[12], q[14];\nrzz(J_zz) q[0], q[6];\nrzz(J_zz) q[1], q[4];\nrzz(J_zz) q[4], q[8];\nrzz(J_zz) q[4], q[12];\nrzz(J_zz) q[4], q[14];\nrzz(J_zz) q[4], q[15];\nrzz(J_zz) q[5], q[6];\nrzz(J_zz) q[5], q[13];\nrzz(J_zz) q[6], q[13];\nrzz(J_zz) q[7], q[9];\nrzz(J_zz) q[8], q[11];\nrzz(J_zz) q[8], q[12];\nrzz(J_zz) q[9], q[15];\nrzz(J_zz) q[10], q[11];\nrzz(J_zz) q[10], q[12];\nrzz(J_zz) q[10], q[14];\nrzz(J_zz) q[11], q[12];\nrz
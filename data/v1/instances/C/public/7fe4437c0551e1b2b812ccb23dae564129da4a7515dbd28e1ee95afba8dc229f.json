 "circuit_qasm3": "OPENQASM 3.0;\ninclude \"stdgates.inc\";\ninput float[64] J_zz;\ninput float[64] h_0;\ngate rzz(p0) _gate_q_0, _gate_q_1 {\n  cx _gate_q_0, _gate_q_1;\n  rz(p0) _gate_q_1;\n  cx _gate_q_0, _gate_q_1;\n}\nqubit[8] q;\nrzz(J_zz) q[0], q[1];\nrzz(J_zz) q[0], q[2];\nrzz(J_zz) q[0], q[3];\nrzz(J_zz) q[0], q[4];\nrzz(J_zz) q[0], q[7];\nrzz(J_zz) q[1], q[3];\nrzz(J_zz) q[2], q[4];\nrzz(J_zz) q[2], q[5];\nrzz(J_zz) q[3], q[4];\nrzz(J_zz) q[4], q[6];\nrzz(J_zz) q[4], q[7];\nrx(h_0) q[0];\nrx(h_0) q[1];\nrx(h_0) q[2];\nrx(h_0) q[3];\nrx(h_0) q[4];\nrx(h_0) q[5];\nrx(h_0) q[6];\nrx(h_0) q[7];\n",

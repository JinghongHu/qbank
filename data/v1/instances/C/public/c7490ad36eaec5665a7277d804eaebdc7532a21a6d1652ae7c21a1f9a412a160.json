 "circuit_qasm3": "OPENQASM 3.0;\ninclude \"stdgates.inc\";\ninput float[64] beta_0;\ninput float[64] gamma_0;\ngate rzz(p0) _gate_q_0, _gate_q_1 {\n  cx _gate_q_0, _gate_q_1;\n  rz(p0) _gate_q_1;\n  cx _gate_q_0, _gate_q_1;\n}\nqubit[16] q;\nh q[0];\nh q[1];\nh q[2];\nh q[3];\nh q[4];\nh q[5];\nh q[6];\nh q[7];\nh q[8];\nh q[9];\nh q[10];\nh q[11];\nh q[12];\nh q[13];\nh q[14];\nh q[15];\nrzz(gamma_0) q[0], q[7];\nrzz(gamma_0) q[0], q[9];\nrzz(gamma_0) q[0], q[11];\nrzz(gamma_0) q[0], q[14];\nrzz(gamma_0) q[1], q[9];\nrzz(gamma_0) q[1], q[10];\nrzz(gamma_0) q[1], q[14];\nrzz(gamma_0) q[1], q[15];\nrzz(gamma_0) q[2], q[5];\nrzz(gamma_0) q[2], q[7];\nrzz(gamma_0) q[2], q[13];\nrzz(gamma_0) q[2], q[14];\nrzz(gamma_0) q[3], q[4];\nrzz(gamma_0) q[3], q[5];\nrzz(gamma_0) q[3], q[11];\nrzz(gamma_0) q[3], q[12];\nrzz(gamma_0) q[4], q[8];\nrzz(gamma_0) q[4], q[11];\nrzz(gamma_0) q[4], q[15];\nrzz(gamma_0) q[5], q[6];\nrzz(gamma_0) q[5], q[10];\nrzz(gamma_0) q[6], q[10];\nrzz(gamma_0) q[6], q[12];\nrzz(gamma_0) q[6], q[13];\nrzz(gamma_0) q[7], q[12];\nrzz(gamma_0) q[7], q[15];\nrzz(gamma_0) q[8], q[10];\nrzz(gamma_0) q[8], q[11];\nrzz(gamma_0) q[8], q[15];\nrzz(gamma_0) q[9], q[13];\nrzz(gamma_0) q[9], q[14];\nrzz(gamma_0) q[12], q[13];\nrx(beta_0) q[0];\nrx(beta_0) q[1];\nrx(beta_0) q[2];\nrx(beta_0) q[3];\nrx(beta_0) q[4];\nrx(beta_0) q[5];\nrx(beta_0) q[6];\nrx(beta_0) q[7];\nrx(beta_0) q[8];\nrx(beta_0) q[9];\nrx(beta_0) q[10];\nrx(beta_0) q[11];\nrx(beta_0) q[12];\nrx(beta_0) q[13];\nrx(beta_0) q[14];\nrx(beta_0) q[15];\n",
